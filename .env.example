# Copy to .env and set your local Postgres URL
# Enable citext once: CREATE EXTENSION IF NOT EXISTS citext;
#
# Host machine (API via npm, DB via Docker):
DATABASE_URL="postgres://postgres:root@localhost:5432/kreate?schema=kreate"
# Inside docker compose, the API service uses host "db" instead of localhost.

JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3000

# Comma-separated allowed frontend origins (required for staging/production browsers)
# Leave empty locally to allow any origin in development
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Frontend base URL used in password-reset links
FRONTEND_URL="http://localhost:5173"

# Resend — https://resend.com/api-keys
# Leave blank locally to log reset links instead of sending email
RESEND_API_KEY=""
EMAIL_FROM="Kreate <onboarding@resend.dev>"
PASSWORD_RESET_EXPIRES_MINUTES="30"

# YouTube / Google OAuth
# Google Cloud OAuth client callback must exactly match this API URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_YOUTUBE_REDIRECT_URI="http://localhost:3000/creators/social/youtube/callback"
# Where the API sends the browser after Google OAuth succeeds/fails.
SOCIAL_OAUTH_FRONTEND_REDIRECT_URL="http://localhost:3000/oauth/youtube"
# Use separate long random secrets in staging/production.
SOCIAL_OAUTH_STATE_SECRET="change-me-to-a-long-random-string"
SOCIAL_TOKEN_ENCRYPTION_KEY="change-me-to-another-long-random-string"
