PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/woosh_backend?schema=public"
JWT_ACCESS_SECRET="replace-with-openssl-rand-base64-32"
JWT_REFRESH_SECRET="replace-with-openssl-rand-base64-32"
# Next.js origin (Vercel), not this API. Verification emails use {FRONTEND_URL}/verify-email
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:4000"

# Payments (Nest owns wallet, Paystack charges, payouts, and the webhook)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYOUT_ACCOUNT_ENCRYPTION_KEY=""
WOOSH_ACCEPT_RATE_THRESHOLD="500000"

# Email (Resend). Leave empty in development to log links in the Nest console.
# Production requires a key. Verify/reset/invite emails go through this service.
RESEND_API_KEY=""
EMAIL_FROM="Woosh <onboarding@resend.dev>"

# File storage — Cloudinary (Nest). Local woosh-backend/uploads if empty in development.
# Dashboard: https://console.cloudinary.com — copy Cloud name, API Key, API Secret.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="woosh"

# Social channel OAuth (Instagram / TikTok / YouTube).
# Instagram via Composio (preferred): enable the Instagram toolkit, copy API key + auth config id.
# Callback (add in Composio): {FRONTEND_URL}/creators/social/instagram/callback
# Instagram still requires a Business/Creator account linked to a Facebook Page.
# Direct Meta Graph remains a fallback if COMPOSIO_* is empty and META_APP_* is set.
# TikTok still returns to Next: {FRONTEND_URL}/api/oauth/tiktok
# YouTube matches kreate: Google calls this URL, then Nest redirects to the frontend.
COMPOSIO_API_KEY=""
COMPOSIO_INSTAGRAM_AUTH_CONFIG_ID=""
# COMPOSIO_INSTAGRAM_CALLBACK_URL="http://localhost:3000/creators/social/instagram/callback"
# COMPOSIO_INSTAGRAM_TOOL_VERSION=""
# COMPOSIO_BASE_URL="https://backend.composio.dev"
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v26.0"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match an Authorized redirect URI on the Google OAuth client.
# Local (same path as kreate, Next on :3000 proxies to Nest):
GOOGLE_YOUTUBE_REDIRECT_URI="http://localhost:3000/creators/social/youtube/callback"
# Direct Nest callback (add this URI in Google Cloud if you prefer):
# GOOGLE_YOUTUBE_REDIRECT_URI="http://localhost:4000/api/creators/social/youtube/callback"
SOCIAL_OAUTH_FRONTEND_REDIRECT_URL="http://localhost:3000/oauth/youtube"
# SOCIAL_OAUTH_INSTAGRAM_FRONTEND_REDIRECT_URL="http://localhost:3000/oauth/instagram"
SOCIAL_OAUTH_STATE_SECRET="replace-with-openssl-rand-base64-32"
OAUTH_TOKEN_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"
WOOSH_ALLOW_DEV_OAUTH="false"

# Scheduler jobs (Bearer secret). Next /api/internal/* can proxy here.
WOOSH_CRON_SECRET="replace-with-openssl-rand-base64-32"
